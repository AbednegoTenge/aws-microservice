pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '559000568151'
        AWS_REGION = 'us-east-1'
        ECR_REPO_NAME = 'microservice'
        AWS_CRED_ID = 'aws-jenkins-credentials'
        ECR_REGISTRY = "559000568151.dkr.ecr.us-east-1.amazonaws.com"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage ("Build Via Docker Compose") {
            steps {
                sh 'docker compose up --build -d'
            }
        }

        stage ('Push to Docker Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${AWS_CRED_ID}", usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                        
                        // 1. Authenticate Docker client against your AWS ECR Registry
                        sh '''
                            set +x
                            aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                        '''
                        
                        sh '''

                            # Orders
                            docker tag node-microservices-orders:latest \
                                "$ECR_REGISTRY/$ECR_REPO_NAME:orders-$IMAGE_TAG"

                            docker tag node-microservices-orders:latest \
                                "$ECR_REGISTRY/$ECR_REPO_NAME:orders-latest"

                            docker push "$ECR_REGISTRY/$ECR_REPO_NAME:orders-$IMAGE_TAG"
                            docker push "$ECR_REGISTRY/$ECR_REPO_NAME:orders-latest"

                            # Products
                            docker tag node-microservices-products:latest \
                                "$ECR_REGISTRY/$ECR_REPO_NAME:products-$IMAGE_TAG"

                            docker tag node-microservices-products:latest \
                                "$ECR_REGISTRY/$ECR_REPO_NAME:products-latest"

                            docker push "$ECR_REGISTRY/$ECR_REPO_NAME:products-$IMAGE_TAG"
                            docker push "$ECR_REGISTRY/$ECR_REPO_NAME:products-latest"

                            # Inventory
                            docker tag node-microservices-inventory:latest \
                                "$ECR_REGISTRY/$ECR_REPO_NAME:inventory-$IMAGE_TAG"

                            docker tag node-microservices-inventory:latest \
                                "$ECR_REGISTRY/$ECR_REPO_NAME:inventory-latest"

                            docker push "$ECR_REGISTRY/$ECR_REPO_NAME:inventory-$IMAGE_TAG"
                            docker push "$ECR_REGISTRY/$ECR_REPO_NAME:inventory-latest"
                        '''
                        
                    }
            }
        }
        stage ('Terraform Init and Plan') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.10.0'
                    args '-u root'
                    reuseNode true
                }
            }
            steps{
                withCredentials([ usernamePassword(credentialsId: "${AWS_CRED_ID}"), usernameVaribale: 'AWS_ACCESS_KEY_ID', passwordVaribale: 'AWS_SECRET_ACCESS_KEY']) {
                        sh '''
                            set -e
                            echo "Initializing Terraform..."
                            terraform init -input=false

                            echo "Validationg Terraform configuration"
                            terraform validate

                            echo "Creating Terraform execution plan"
                            terraform plan -input=false -out=tfplan

                            echo "Terraform plan created successfully
                        '''
                    }
            }
        }
        stage ('Terraform Apply') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.10.0'
                    args '-u root'
                    reuseNode true
                }
            }
            steps {
                withCredentials([
                    usernamePassword(crendentialsId: "${AWS_CRED_ID}"),
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                ]) {
                    sh '''
                        set -e
                        echo "Applying Terraform plan"
                        terraform apply -input=false -auto-approve tfplan
                        echo "Terraform Apply applied successfully"
                    '''
                }
            }
        }
    }
    post {
        always {

            echo 'Cleaning up Docker resources...'

            sh '''
                docker compose down --volumes || true
            '''

            sh '''
                docker rmi \
                    "$ECR_REGISTRY/$ECR_REPO_NAME:orders-$IMAGE_TAG" \
                    "$ECR_REGISTRY/$ECR_REPO_NAME:products-$IMAGE_TAG" \
                    "$ECR_REGISTRY/$ECR_REPO_NAME:inventory-$IMAGE_TAG" \
                    || true
            '''
        }

        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console logs.'
        }
    }
}