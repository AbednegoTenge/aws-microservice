pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '559000568151'
        AWS_REGION = 'us-east-1'
        ECR_REPO_NAME = 'microservice'
        AWS_CRED_ID = 'aws-jenkins-credentials'
    }

    stages {
        stage ("Build Via Docker Compose") {
            steps {
                sh 'docker compose up --build -d'
            }
        }

        stage ('Run Tests inside Container') {
            steps {
                echo 'Spinning up microservice environment to run automated tests'
                sh 'docker compose run --rm app npm test'
            }
        }

        stage ('Push to Docker Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${AWS_CRED_ID}", usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                        
                        // 1. Authenticate Docker client against your AWS ECR Registry
                        sh """
                            export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                            export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                            export AWS_DEFAULT_REGION=${AWS_REGION}
                            aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        """
                        
                        // 2. Tag the local image generated by Docker Compose to match ECR requirements
                        // Note: 'latest' matches the default tag docker-compose generates if not overwritten
                        sh "docker tag ${ECR_REPO_NAME}:latest ${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG}"
                        sh "docker tag ${ECR_REPO_NAME}:latest ${ECR_REGISTRY}/${ECR_REPO_NAME}:latest"
                        
                        // 3. Push both the unique build number tag and the latest tag to AWS
                        sh "docker push ${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG}"
                        sh "docker push ${ECR_REGISTRY}/${ECR_REPO_NAME}:latest"
                    }
            }
        }
    }
    post {
        always {
            echo 'Cleaning up local images...'
            sh "docker rmi ${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG} || true"
            sh "docker compose down --volumes || true"
        }
    }
}